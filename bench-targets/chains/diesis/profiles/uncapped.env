# Diagnosis only: no CPU or memory limits and the Nov 8-9 frozen compose's capacity values
# (16 GiB Work, proposal cap 768, block cap 16,000, 250 ms leader timeout, idle stretch 1,
# flush gas threshold 5M, RPC limits 1,500/s per connection and 30,000/s global).
# Validators log to file at info like capped, so the two profiles differ only in capacity;
# diagnostic arms opt into debug with BENCH_DIESIS_FILE_LOG_FILTER (ab.py: filelog=debug).
FLEET_FILE_LOG_FILTER=info
DIESIS_NONVALIDATOR_MSG_BUDGET=100000
DIESIS_TXPOOL_MAX_ACCOUNT_SLOTS=5000
DIESIS_NODE_RUST_LOG=info
DIESIS_VALIDATOR_RUST_LOG=info
DIESIS_SELECTED_ENCODED_WORK_BYTES=17179869184
DIESIS_MAX_PROPOSAL_TX_COUNT=768
DIESIS_MAX_BLOCK_TX_COUNT=16000
DIESIS_LEADER_TIMEOUT=250ms
DIESIS_IDLE_STRETCH=1
DIESIS_FLUSH_GAS_THRESHOLD=5000000
DIESIS_RATE_LIMIT_PER_CONN_RPS=1500
DIESIS_RATE_LIMIT_PER_CONN_BURST=3000
DIESIS_RATE_LIMIT_GLOBAL_RPS=30000
DIESIS_RATE_LIMIT_GLOBAL_BURST=40000
