# Official run rule: EVM targets are judged with this profile (docs/diesis-methodology.md).
# The Phase 0 / MPT validator fixture shape: 4 validators, 2 pinned CPUs and 4 GiB each,
# two Rayon threads, the node's e2e defaults for timing (200 ms block period, 20 ms ordering
# window, 50 ms minimum round delay), selected encoded Work at its 1 GiB default, proposal
# cap 2,048, RPC limits 50/s per connection and 5,000/s global, 50k txpool.
FLEET_CPUS=2
FLEET_MEMORY=4g
FLEET_PIN_CPUS=true
DIESIS_E2E_RAYON_THREADS=2
RAYON_NUM_THREADS=2
DIESIS_MAX_BLOCK_TX_COUNT=5000
DIESIS_NONVALIDATOR_MSG_BUDGET=100000
DIESIS_TXPOOL_MAX_ACCOUNT_SLOTS=5000
DIESIS_NODE_RUST_LOG=info
DIESIS_VALIDATOR_RUST_LOG=info
